# MCP Server Configuration
MCP_SERVER_PORT=8000

# OpenAI API (optional - only needed for OpenAI embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face token (optional - only needed for gated/private models)
HUGGINGFACE_HUB_TOKEN=

# Vector Store Configuration
VECTOR_STORE_TYPE=chromadb
CHROMA_DB_PATH=./data/chroma_db

# Embedding Model (local models don't require API keys)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_MODEL=text-embedding-3-small

# Chunking and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Document Storage
DOCUMENT_STORAGE_PATH=./data/documents

# LLM Configuration (for answer generation)
USE_LLM=true
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
USE_SIMPLE_LLM=false
LLM_DEVICE=
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.9
# LLM_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct  # Better quality, heavier
# LLM_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0  # Larger fallback
# LLM_MODEL_NAME=distilgpt2  # Very small fallback, poor answer quality
